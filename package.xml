<?xml version="1.0"?>
<package format="2">
  <name>moveit_whole_body_ik</name>
  <version>0.1.0</version>
  <description>Self-contained MoveIt whole-body IK services for the IR100 mobile manipulator.</description>

  <maintainer email="2398603105@qq.com">yangzhaofeng496</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>message_generation</build_depend>

  <depend>geometry_msgs</depend>
  <depend>actionlib</depend>
  <depend>control_msgs</depend>
  <depend>gazebo_msgs</depend>
  <depend>std_srvs</depend>
  <depend>kdl_parser</depend>
  <depend>moveit_core</depend>
  <depend>moveit_msgs</depend>
  <depend>moveit_ros_planning</depend>
  <depend>octomap</depend>
  <depend>octomap_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>pluginlib</depend>
  <depend>roslib</depend>
  <depend>roscpp</depend>
  <depend>rviz</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>
  <depend>xacro</depend>
  <depend>moveit_ros_planning_interface</depend>

  <exec_depend>message_runtime</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>robot_description</exec_depend>

  <export>
    <rviz plugin="${prefix}/csv_whole_body_ik_panel_plugin.xml" />
  </export>
</package>
